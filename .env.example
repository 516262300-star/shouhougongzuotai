APP_NAME=利德仕电商自动化售后工作台
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=mysql+pymysql://aftersales:change_me@127.0.0.1:3306/aftersales?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
LOG_LEVEL=INFO

# 拼多多单店只读联调（不要将真实值提交到 Git）
PDD_SHOP_CODE=pdd-test-shop
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_ACCESS_TOKEN=
PDD_API_URL=https://gw-api.pinduoduo.com/api/router
PDD_TIMEOUT_SECONDS=10
PDD_READ_MAX_ATTEMPTS=5
PDD_WRITE_ENABLED=false
PDD_SYNC_INITIAL_LOOKBACK_HOURS=72
PDD_SYNC_OVERLAP_SECONDS=300
PDD_SYNC_PAGE_SIZE=100
ERP_WRITE_ENABLED=false

# 模块 1 企微快递拦截群机器人（Webhook 属于密钥，不要提交真实值）
QYWX_INTERCEPT_WEBHOOK_URL=
QYWX_TIMEOUT_SECONDS=10
QYWX_WRITE_ENABLED=false

# 模块 1 后台运行器。5 店 Token 当前失效，因此默认暂不运行 5 店。
MODULE1_WORKER_SHOP_NUMBERS=[1,2,3,4,6,7]
MODULE1_WORKER_INTERVAL_SECONDS=60
MODULE1_WORKER_MAX_SYNC_WINDOWS=2
MODULE1_WORKER_TASK_LIMIT=20
# 可选 disabled / qywx_webhook；桌面自动发送适配器后续可接入同一出口
MODULE1_NOTIFICATION_TRANSPORT=disabled
# 必须与 PDD_WRITE_ENABLED 同时为 true 才会真实调用拼多多退款
MODULE1_PDD_REFUND_EXECUTION_ENABLED=false
# 拼多多物流公司 ID 到企业微信外部群完整精确群名；真实群名只写本机 .env
MODULE1_DESKTOP_GROUP_MAP={}
MODULE1_DESKTOP_SEND_ENABLED=false

# 模块 1 快递 100 只读物流轨迹（凭据不要提交到 Git）
KUAIDI100_API_URL=https://poll.kuaidi100.com/poll/query.do
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
KUAIDI100_DEFAULT_PHONE=
KUAIDI100_TIMEOUT_SECONDS=10
# 左侧填写拼多多物流公司 ID，右侧填写快递 100 公司代码
KUAIDI100_CARRIER_MAP={"85":"yuantong","131":"debangwuliu","384":"jtexpress"}

# 两组拼多多开放平台应用凭据
# APP_1 对应 1–4 店；APP_2 对应 5–7 店
PDD_APP_1_CLIENT_ID=
PDD_APP_1_CLIENT_SECRET=
PDD_APP_2_CLIENT_ID=
PDD_APP_2_CLIENT_SECRET=

# 拼多多 1–7 店独立 Token（只填本店对应的 Token）
PDD_SHOP_1_CODE=pdd-shop-01
PDD_SHOP_1_APP=1
PDD_SHOP_1_ACCESS_TOKEN=
PDD_SHOP_2_CODE=pdd-shop-02
PDD_SHOP_2_APP=1
PDD_SHOP_2_ACCESS_TOKEN=
PDD_SHOP_3_CODE=pdd-shop-03
PDD_SHOP_3_APP=1
PDD_SHOP_3_ACCESS_TOKEN=
PDD_SHOP_4_CODE=pdd-shop-04
PDD_SHOP_4_APP=1
PDD_SHOP_4_ACCESS_TOKEN=
PDD_SHOP_5_CODE=pdd-shop-05
PDD_SHOP_5_APP=2
PDD_SHOP_5_ACCESS_TOKEN=
PDD_SHOP_6_CODE=pdd-shop-06
PDD_SHOP_6_APP=2
PDD_SHOP_6_ACCESS_TOKEN=
PDD_SHOP_7_CODE=pdd-shop-07
PDD_SHOP_7_APP=2
PDD_SHOP_7_ACCESS_TOKEN=
