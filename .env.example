APP_NAME=利德仕电商自动化售后工作台
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=mysql+pymysql://aftersales:change_me@127.0.0.1:3306/aftersales?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
LOG_LEVEL=INFO

# 拼多多单店只读联调（不要将真实值提交到 Git）
PDD_SHOP_CODE=pdd-test-shop
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_ACCESS_TOKEN=
PDD_API_URL=https://gw-api.pinduoduo.com/api/router
PDD_TIMEOUT_SECONDS=10
PDD_READ_MAX_ATTEMPTS=5
PDD_WRITE_ENABLED=false
PDD_SYNC_INITIAL_LOOKBACK_HOURS=72
PDD_SYNC_OVERLAP_SECONDS=300
PDD_SYNC_PAGE_SIZE=100
ERP_WRITE_ENABLED=false
# 旧管理系统 MySQL 的只读账号连接；仅需 SELECT 00sobackup、kehu
ERP_READ_DATABASE_URL=
ERP_READ_CACHE_SECONDS=300
# 未配置数据库连接时，可用管理系统员工账号进行只读网页查询
ERP_WEB_LOOKUP_ENABLED=false
ERP_WEB_BASE_URL=https://ldswj.net
ERP_WEB_USERNAME=
ERP_WEB_PASSWORD=
ERP_WEB_TIMEOUT_SECONDS=15
# 模块 1 每个周期小批量刷新售后订单的 ERP 归属业务员缓存
ERP_SALES_OWNER_SYNC_ENABLED=false
ERP_SALES_OWNER_SYNC_BATCH_SIZE=20
ERP_SALES_OWNER_REFRESH_SECONDS=86400
# 模块 1 人工场景发布到管理系统“待办事项”；必须同时开启 ERP_WRITE_ENABLED
ERP_TODO_PUBLISH_ENABLED=false
# 远端发布使用售后单号幂等核验，失败任务最多自动重新入队次数
ERP_TODO_MAX_ATTEMPTS=3
# 模块 1 拦截退回后的只读闭环核对；不写旧 ERP，但会更新本地售后状态
ERP_RETURN_MATCH_SYNC_ENABLED=false
ERP_RETURN_MATCH_BATCH_SIZE=20
# 后台每分钟循环一次，但同一退货单默认每 30 分钟才访问 ERP 复查
ERP_RETURN_MATCH_REFRESH_SECONDS=1800
# 客户累计应收绝对值不超过该金额，视为已归零
ERP_RETURN_MATCH_RECEIVABLE_TOLERANCE=0.01

# 模块 1 企微快递拦截群机器人（Webhook 属于密钥，不要提交真实值）
QYWX_INTERCEPT_WEBHOOK_URL=
QYWX_TIMEOUT_SECONDS=10
QYWX_WRITE_ENABLED=false

# 模块 1 后台运行器，默认同步拼多多 1–7 店。
MODULE1_WORKER_SHOP_NUMBERS=[1,2,3,4,5,6,7]
MODULE1_WORKER_INTERVAL_SECONDS=60
MODULE1_WORKER_MAX_SYNC_WINDOWS=2
MODULE1_WORKER_TASK_LIMIT=20
# 可选 disabled / qywx_webhook / desktop；desktop 还需独立发送开关
MODULE1_NOTIFICATION_TRANSPORT=disabled
# 自动通知只处理大于等于该任务 ID 的拦截任务；上线时填“当前最大任务 ID + 1”
MODULE1_NOTIFICATION_MIN_TASK_ID=0
# 必须与 PDD_WRITE_ENABLED 同时为 true 才会真实调用拼多多退款
MODULE1_PDD_REFUND_EXECUTION_ENABLED=false
# 拼多多物流公司 ID 到企业微信外部群完整精确群名；真实群名只写本机 .env
MODULE1_DESKTOP_GROUP_MAP={}
MODULE1_DESKTOP_SEND_ENABLED=false
MODULE1_DESKTOP_PROCESS_NAME=WXWork.exe
MODULE1_DESKTOP_LEDGER_PATH=.runtime/desktop-notice-ledger.jsonl
MODULE1_DESKTOP_LOCK_PATH=.runtime/desktop-notice.lock
# 后台每个周期最多发送多少条桌面消息；首次上线保持 1
MODULE1_DESKTOP_BATCH_LIMIT=1

# 模块 1 快递 100 只读物流轨迹（凭据不要提交到 Git）
KUAIDI100_API_URL=https://poll.kuaidi100.com/poll/query.do
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
KUAIDI100_DEFAULT_PHONE=
KUAIDI100_TIMEOUT_SECONDS=10
# 左侧填写拼多多物流公司 ID，右侧填写快递 100 公司代码
KUAIDI100_CARRIER_MAP={"85":"yuantong","131":"debangwuliu","384":"jtexpress"}
# 查询成功后至少 5 分钟再刷新；失败按 5/10/20/30 分钟退避
KUAIDI100_SUCCESS_REFRESH_SECONDS=300
KUAIDI100_FAILURE_INITIAL_RETRY_SECONDS=300
KUAIDI100_FAILURE_MAX_RETRY_SECONDS=1800
# 连续失败达到该次数后在售后工作台标记“需人工核对”，退款仍保持冻结
KUAIDI100_MANUAL_AFTER_FAILURES=6

# 两组拼多多开放平台应用凭据
# APP_1 对应 1–4 店；APP_2 对应 5–7 店
PDD_APP_1_CLIENT_ID=
PDD_APP_1_CLIENT_SECRET=
PDD_APP_2_CLIENT_ID=
PDD_APP_2_CLIENT_SECRET=

# 拼多多 1–7 店独立 Token（只填本店对应的 Token）
PDD_SHOP_1_CODE=pdd-shop-01
PDD_SHOP_1_APP=1
PDD_SHOP_1_ACCESS_TOKEN=
PDD_SHOP_2_CODE=pdd-shop-02
PDD_SHOP_2_APP=1
PDD_SHOP_2_ACCESS_TOKEN=
PDD_SHOP_3_CODE=pdd-shop-03
PDD_SHOP_3_APP=1
PDD_SHOP_3_ACCESS_TOKEN=
PDD_SHOP_4_CODE=pdd-shop-04
PDD_SHOP_4_APP=1
PDD_SHOP_4_ACCESS_TOKEN=
PDD_SHOP_5_CODE=pdd-shop-05
PDD_SHOP_5_APP=2
PDD_SHOP_5_ACCESS_TOKEN=
PDD_SHOP_6_CODE=pdd-shop-06
PDD_SHOP_6_APP=2
PDD_SHOP_6_ACCESS_TOKEN=
PDD_SHOP_7_CODE=pdd-shop-07
PDD_SHOP_7_APP=2
PDD_SHOP_7_ACCESS_TOKEN=
